# Copy to apps/api/.env and fill in real values. Never commit real secrets.

# Neon pooled connection string (app runtime)
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_POOLED_HOST/YOUR_DB?sslmode=require"

# Neon unpooled connection string (prisma migrate)
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_DIRECT_HOST/YOUR_DB?sslmode=require"

# Server-side pepper for password hashing (same value as the web's while auth runs there)
PASSWORD_PEPPER="YOUR_SECRET_HERE"

# Secret for signing the guest cart cookie
GUEST_CART_SECRET="YOUR_SECRET_HERE"

# Shared secret the web proxy sends on every API call; must equal apps/web's value
WEB_PROXY_SECRET="YOUR_SECRET_HERE"
