# Copy to apps/web/.env and fill in real values. Never commit real secrets.

# Where the /api proxy and apiFetch send requests (local API by default)
API_URL="http://localhost:4000"

# Shared secret sent to the API on every call; must equal apps/api's value
WEB_PROXY_SECRET="YOUR_SECRET_HERE"

# TEMPORARY until auth-api-migration: the auth code still runs in the web app
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_POOLED_HOST/YOUR_DB?sslmode=require"
# TEMPORARY until auth-api-migration
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_DIRECT_HOST/YOUR_DB?sslmode=require"
# TEMPORARY until auth-api-migration
PASSWORD_PEPPER="YOUR_SECRET_HERE"
# TEMPORARY until auth-api-migration: Postgres for the *.db.test.ts suites and auth e2e
TEST_DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/stride_test"
